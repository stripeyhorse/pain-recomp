 {
     static int off = -1;
-    if (off < 0) { const char* e = getenv("D3D12_VSYNC"); off = e && *e == '0'; }
+    if (off < 0) {
+        const char* e = getenv("PS3RECOMP_VSYNC");
+        if (!e) e = getenv("D3D12_VSYNC");
+        off = e && *e == '0';
+    }
     return off;
 }
 
