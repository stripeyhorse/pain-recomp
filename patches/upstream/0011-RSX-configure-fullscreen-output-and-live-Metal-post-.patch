 libs/video/rsx_metal_backend.h             |  19 +++
 libs/video/rsx_metal_backend.m             | 175 ++++++++++++++++++---
 libs/video/rsx_vulkan_backend.c            |  42 +++--
 libs/video/tests/test_metal_present_post.m |  23 +++
 5 files changed, 236 insertions(+), 29 deletions(-)

