From fb551632fd0ff3952bc534e43d3f563f7a3cdd51 Mon Sep 17 00:00:00 2001
From: StripeyHorse <stripeyhorse@gmail.com>
Date: Fri, 20 Nov 2026 22:12:15 +1100
Subject: [PATCH 12/12] =?UTF-8?q?RSX:=20preserve=20each=20face=E2=80=99s?=
 =?UTF-8?q?=20stencil=20masks=20and=20reference?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Initialise the back-face NV40 registers, carry separate masks into pipeline keys, and set the two references dynamically in Metal and Vulkan. Preserve the shared front reference for one-sided stencil.
---
 libs/video/rsx_dispatch.c               | 13 +++++++
 libs/video/rsx_draw_engine.c            | 19 +++++++++-
 libs/video/rsx_draw_engine.h            |  5 ++-
 libs/video/rsx_metal_backend.m          | 18 +++++----
 libs/video/rsx_vulkan_backend.c         | 20 +++++++---
 libs/video/tests/test_rsx_draw_engine.c | 50 ++++++++++++++++++++++++-
 6 files changed, 109 insertions(+), 16 deletions(-)

diff --git a/libs/video/rsx_dispatch.c b/libs/video/rsx_dispatch.c
index a7ef902..c74fbdb 100644
--- a/libs/video/rsx_dispatch.c
+++ b/libs/video/rsx_dispatch.c
@@ -178,6 +178,19 @@ void rsx_dispatch_init(rsx_dispatch* rsx, const rsx_dispatch_sink* sink)
      * a title that turned clipping off. */
     rsx->regs[0x1D78 >> 2] = 0x00000001u;
 
+    /* NV40 stencil reset state for each face: allow writing/comparing all
+     * bits, pass the comparison and keep the stored value on each outcome.
+     * The reference is already zero. Some draws enable stencil and program
+     * only the operations that differ from these defaults. */
+    for (u32 face = 0; face <= 0x20; face += 0x20) {
+        rsx->regs[(0x032Cu + face) >> 2] = 0xFFu;
+        rsx->regs[(0x0330u + face) >> 2] = 0x0207u;
+        rsx->regs[(0x0338u + face) >> 2] = 0xFFu;
+        rsx->regs[(0x033Cu + face) >> 2] = 0x1E00u;
+        rsx->regs[(0x0340u + face) >> 2] = 0x1E00u;
+        rsx->regs[(0x0344u + face) >> 2] = 0x1E00u;
+    }
+
     /* Execution methods */
     mark_class(rsx, M_VERTEX_BEGIN_END,  1, RSX_DSP_CLASS_EXEC);
     mark_class(rsx, M_VB_VERTEX_BATCH,   1, RSX_DSP_CLASS_EXEC);
diff --git a/libs/video/rsx_draw_engine.c b/libs/video/rsx_draw_engine.c
index 19548e0..4ae457a 100644
--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -78,7 +78,10 @@ extern u32 ppu_vm_size;
 #define M_STENCIL_OP_ZFAIL    0x0340
 #define M_STENCIL_OP_ZPASS    0x0344
 #define M_TWO_SIDED_STENCIL   0x0348
+#define M_BACK_STENCIL_MASK   0x034C
 #define M_BACK_STENCIL_FUNC   0x0350
+#define M_BACK_STENCIL_REF    0x0354
+#define M_BACK_STENCIL_FUNC_MASK 0x0358
 #define M_BACK_STENCIL_OP_FAIL  0x035C
 #define M_BACK_STENCIL_OP_ZFAIL 0x0360
 #define M_BACK_STENCIL_OP_ZPASS 0x0364
@@ -460,6 +463,8 @@ void rsx_draw_engine_decode_render_state(const rsx_dispatch* rsx,
     rs->s_zfail      = rsx_dsp_reg(rsx, M_STENCIL_OP_ZFAIL);
     rs->s_zpass      = rsx_dsp_reg(rsx, M_STENCIL_OP_ZPASS);
     rs->bs_func      = rsx_dsp_reg(rsx, M_BACK_STENCIL_FUNC);
+    rs->bs_func_mask = rsx_dsp_reg(rsx, M_BACK_STENCIL_FUNC_MASK) & 0xFF;
+    rs->bs_write_mask = rsx_dsp_reg(rsx, M_BACK_STENCIL_MASK) & 0xFF;
     rs->bs_fail      = rsx_dsp_reg(rsx, M_BACK_STENCIL_OP_FAIL);
     rs->bs_zfail     = rsx_dsp_reg(rsx, M_BACK_STENCIL_OP_ZFAIL);
     rs->bs_zpass     = rsx_dsp_reg(rsx, M_BACK_STENCIL_OP_ZPASS);
@@ -513,6 +518,10 @@ u64 rsx_draw_engine_hash_render_state(const rsx_be_render_state* rs, u64 hash)
     ENG_HASH_FIELD(s_zfail);
     ENG_HASH_FIELD(s_zpass);
     ENG_HASH_FIELD(bs_func);
+    if (rs->stencil_two_sided) {
+        ENG_HASH_FIELD(bs_func_mask);
+        ENG_HASH_FIELD(bs_write_mask);
+    }
     ENG_HASH_FIELD(bs_fail);
     ENG_HASH_FIELD(bs_zfail);
     ENG_HASH_FIELD(bs_zpass);
@@ -3453,8 +3462,14 @@ static void sink_end(void* user, const rsx_dispatch* r)
         g.be->set_scissor(g.be->user, sc[0], sc[1], sc[2], sc[3]);
     }
     /* Dynamic, and deliberately outside the pipeline key. */
-    g.be->set_stencil_ref(g.be->user,
-                          rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu);
+    const u32 front_ref = rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu;
+    if (g.be->set_stencil_refs) {
+        const u32 back_ref = rs.stencil_two_sided
+            ? rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_REF) & 0xFFu : front_ref;
+        g.be->set_stencil_refs(g.be->user, front_ref, back_ref);
+    } else if (g.be->set_stencil_ref) {
+        g.be->set_stencil_ref(g.be->user, front_ref);
+    }
     /* The bounds too: a deferred renderer moves them between its light and
      * sky passes without changing anything else. Raw floats, as written. */
     if (g.be->set_depth_bounds) {
diff --git a/libs/video/rsx_draw_engine.h b/libs/video/rsx_draw_engine.h
index 097692c..f4fda44 100644
--- a/libs/video/rsx_draw_engine.h
+++ b/libs/video/rsx_draw_engine.h
@@ -99,7 +99,7 @@ typedef struct rsx_be_render_state {
      * off). A backend without depth clamping draws it clipped. */
     u32 depth_clamp;
     u32 s_func, s_func_mask, s_write_mask, s_fail, s_zfail, s_zpass;
-    u32 bs_func, bs_fail, bs_zfail, bs_zpass;
+    u32 bs_func, bs_func_mask, bs_write_mask, bs_fail, bs_zfail, bs_zpass;
 } rsx_be_render_state;
 
 /* submit_and_wait reasons, for a backend that wants to log or count them. */
@@ -300,6 +300,9 @@ typedef struct rsx_draw_backend {
                                      float depth_value, u8 stencil,
                                      u32 x, u32 y, u32 w, u32 h);
 
+    /* Optional independent references for backends with two-sided stencil.
+     * With two-sided stencil off both arguments carry the front reference. */
+    void (*set_stencil_refs)(void* user, u32 front, u32 back);
 } rsx_draw_backend;
 
 /* ---- the engine --------------------------------------------------------- */
diff --git a/libs/video/rsx_metal_backend.m b/libs/video/rsx_metal_backend.m
index 113efa2..62f09d7 100644
--- a/libs/video/rsx_metal_backend.m
+++ b/libs/video/rsx_metal_backend.m
@@ -2633,7 +2633,7 @@ typedef struct {
     int vsamp[RSX_BE_MAX_VERTEX_TEXTURES];
     float vp[4];
     u32   sc[4];
-    u32   stencil_ref;
+    u32   stencil_ref, back_stencil_ref;
     float clear_rgba[4];
     u32   clear_flags;
     float clear_depth;
@@ -3618,8 +3618,8 @@ static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_h
             bsd.stencilFailureOperation   = gcm_stencil_op_to_metal(rs->bs_fail);
             bsd.depthFailureOperation     = gcm_stencil_op_to_metal(rs->bs_zfail);
             bsd.depthStencilPassOperation = gcm_stencil_op_to_metal(rs->bs_zpass);
-            bsd.readMask                  = rs->s_func_mask & 0xFFu;
-            bsd.writeMask                 = rs->s_write_mask & 0xFFu;
+            bsd.readMask                  = rs->bs_func_mask & 0xFFu;
+            bsd.writeMask                 = rs->bs_write_mask & 0xFFu;
             dd.backFaceStencil = bsd;
         } else {
             /* Two-sided off: nv40 applies the front state to both faces. */
@@ -3790,8 +3790,12 @@ static void eng_set_scissor(void* user, u32 x, u32 y, u32 w, u32 h)
     s_eng_pending.sc[2] = w; s_eng_pending.sc[3] = h;
 }
 
-static void eng_set_stencil_ref(void* user, u32 ref)
-{ (void)user; s_eng_pending.stencil_ref = ref; }
+static void eng_set_stencil_refs(void* user, u32 front, u32 back)
+{
+    (void)user;
+    s_eng_pending.stencil_ref = front;
+    s_eng_pending.back_stencil_ref = back;
+}
 
 /* Polygon offset. glPolygonOffset's units are steps of the guest depth
  * buffer, 2^-16 for Z16 and 2^-24 for Z24S8. Metal's depthBias on the
@@ -3905,7 +3909,7 @@ static void eng_encode_draw(id<MTLRenderCommandEncoder> enc, const EngRecord* r,
     [enc setCullMode:p->cull];
     [enc setFrontFacingWinding:p->winding];
     [enc setDepthClipMode:p->clip];
-    [enc setStencilReferenceValue:r->stencil_ref];
+    [enc setStencilFrontReferenceValue:r->stencil_ref backReferenceValue:r->back_stencil_ref];
     [enc setDepthBias:r->depth_bias slopeScale:r->depth_slope clamp:0.0f];
     MTLViewport vp = { r->vp[0], r->vp[1], r->vp[2], r->vp[3], 0.0, 1.0 };
     [enc setViewport:vp];
@@ -4867,7 +4871,7 @@ static const rsx_draw_backend s_engine_backend = {
     .bind_vertex_textures = eng_bind_vertex_textures,
     .set_viewport         = eng_set_viewport,
     .set_scissor          = eng_set_scissor,
-    .set_stencil_ref      = eng_set_stencil_ref,
+    .set_stencil_refs     = eng_set_stencil_refs,
     .set_depth_bias       = eng_set_depth_bias,
     .draw                 = eng_draw,
     .clear_color          = eng_clear_color,
diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index e9fa853..71d5a98 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3008,7 +3008,7 @@ static struct {
     float        vp[4];
     u32          sc[4];
     int          have_vp, have_sc;
-    u32          stencil_ref;
+    u32          stencil_ref, back_stencil_ref;
     float        depth_bounds[2];     /* min, max for the next draw */
     vk_buffer    indices;
     u32          warned;
@@ -3302,7 +3302,7 @@ static VkPipeline vk_eng_variant(vk_eng_pipe* P, u32 topo_idx)
                                                  rs->s_func_mask, rs->s_write_mask);
     VkStencilOpState back = rs->stencil_two_sided
         ? vk_gcm_stencil_face(rs->bs_func, rs->bs_fail, rs->bs_zfail, rs->bs_zpass,
-                              rs->s_func_mask, rs->s_write_mask)
+                              rs->bs_func_mask, rs->bs_write_mask)
         : front;
     VkPipelineDepthStencilStateCreateInfo ds = {
         .sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO,
@@ -3470,7 +3470,12 @@ static void vk_eng_set_scissor(void* user, u32 x, u32 y, u32 w, u32 h)
     (void)user;
     s_e2.sc[0] = x; s_e2.sc[1] = y; s_e2.sc[2] = w; s_e2.sc[3] = h; s_e2.have_sc = 1;
 }
-static void vk_eng_set_stencil_ref(void* user, u32 ref) { (void)user; s_e2.stencil_ref = ref; }
+static void vk_eng_set_stencil_refs(void* user, u32 front, u32 back)
+{
+    (void)user;
+    s_e2.stencil_ref = front;
+    s_e2.back_stencil_ref = back;
+}
 
 /* Vulkan wants the bounds inside [0, 1] without VK_EXT_depth_range_unrestricted;
  * a NaN clamps to the open end so a garbage register cannot reject a draw. */
@@ -3910,7 +3915,12 @@ static void vk_eng_draw(void* user, rsx_topology topology, const void* vertices,
     }
     pvkCmdSetViewport(s_vk.cmd, 0, 1, &vp);
     pvkCmdSetScissor(s_vk.cmd, 0, 1, &sc);
-    pvkCmdSetStencilReference(s_vk.cmd, VK_STENCIL_FACE_FRONT_AND_BACK, s_e2.stencil_ref & 0xFFu);
+    if (s_e2.stencil_ref == s_e2.back_stencil_ref) {
+        pvkCmdSetStencilReference(s_vk.cmd, VK_STENCIL_FACE_FRONT_AND_BACK, s_e2.stencil_ref);
+    } else {
+        pvkCmdSetStencilReference(s_vk.cmd, VK_STENCIL_FACE_FRONT_BIT, s_e2.stencil_ref);
+        pvkCmdSetStencilReference(s_vk.cmd, VK_STENCIL_FACE_BACK_BIT, s_e2.back_stencil_ref);
+    }
     if (s_vk.depth_bounds_ok)
         pvkCmdSetDepthBounds(s_vk.cmd, s_e2.depth_bounds[0], s_e2.depth_bounds[1]);
     pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS,
@@ -3954,7 +3964,7 @@ static const rsx_draw_backend s_vk_engine_backend = {
     .bind_vertex_textures = vk_eng_bind_vertex_textures,
     .set_viewport         = vk_eng_set_viewport,
     .set_scissor          = vk_eng_set_scissor,
-    .set_stencil_ref      = vk_eng_set_stencil_ref,
+    .set_stencil_refs     = vk_eng_set_stencil_refs,
     .set_depth_bounds     = vk_eng_set_depth_bounds,
     .draw                 = vk_eng_draw,
     .clear_color          = vk_eng_clear_color,
diff --git a/libs/video/tests/test_rsx_draw_engine.c b/libs/video/tests/test_rsx_draw_engine.c
index aabad93..5aea99a 100644
--- a/libs/video/tests/test_rsx_draw_engine.c
+++ b/libs/video/tests/test_rsx_draw_engine.c
@@ -93,7 +93,7 @@ typedef struct {
     float draw_first_vertex[4];   /* ATTR0 of the first vertex handed over */
     rsx_topology draw_topology;
     u32 scissor[4];
-    u32 stencil_ref;
+    u32 stencil_ref, back_stencil_ref;
     float depth_bounds[2];
     int n_depth_bounds;
     u32 last_created_texture, last_created_color;
@@ -229,6 +229,11 @@ static void stub_scissor(void* u, u32 x, u32 y, u32 w, u32 h)
 }
 
 static void stub_stencil_ref(void* u, u32 r) { (void)u; stub.stencil_ref = r; }
+static void stub_stencil_refs(void* u, u32 front, u32 back)
+{
+    stub_stencil_ref(u, front);
+    stub.back_stencil_ref = back;
+}
 static void stub_depth_bounds(void* u, float lo, float hi)
 {
     (void)u;
@@ -1039,6 +1044,48 @@ static void test_pipeline_key(void)
 
 /* ---- 5. restart cuts and topology expansion ------------------------------ */
 
+static void test_two_sided_stencil(void)
+{
+    engine_up();
+    rsx_draw_backend backend = g_stub_backend;
+    backend.set_stencil_refs = stub_stencil_refs;
+    rsx_draw_engine_set_backend(&backend);
+
+    m(0x0328, 1);       /* STENCIL_TEST_ENABLE */
+    m(0x0348, 1);       /* TWO_SIDED_STENCIL_TEST_ENABLE */
+    draw_triangle();
+    CHECK(stub.pipeline_rs.s_write_mask == 0xff && stub.pipeline_rs.bs_write_mask == 0xff &&
+          stub.pipeline_rs.bs_func_mask == 0xff && stub.pipeline_rs.bs_zpass == 0x1e00,
+          "front and back stencil registers start with the NV40 reset values");
+
+    m(0x032C, 0x0F);    /* STENCIL_MASK */
+    m(0x0338, 0xF0);    /* STENCIL_FUNC_MASK */
+    m(0x034C, 0xF0);    /* BACK_STENCIL_MASK */
+    m(0x0358, 0x0F);    /* BACK_STENCIL_FUNC_MASK */
+    m(0x0334, 0x14);    /* STENCIL_FUNC_REF */
+    m(0x0354, 0x41);    /* BACK_STENCIL_FUNC_REF */
+    draw_triangle();
+    CHECK(stub.pipeline_rs.s_write_mask == 0x0f && stub.pipeline_rs.bs_write_mask == 0xf0 &&
+          stub.pipeline_rs.s_func_mask == 0xf0 && stub.pipeline_rs.bs_func_mask == 0x0f,
+          "each face uses its own compare and write masks");
+    CHECK(stub.stencil_ref == 0x14 && stub.back_stencil_ref == 0x41,
+          "each face uses its own reference");
+    const int pipelines = stub.n_pipeline_create;
+    m(0x0354, 0x62);
+    draw_triangle();
+    CHECK(stub.back_stencil_ref == 0x62 && stub.n_pipeline_create == pipelines,
+          "changing only the back reference does not recompile the pipeline");
+    m(0x0358, 0x3F);
+    draw_triangle();
+    CHECK(stub.pipeline_rs.bs_func_mask == 0x3f && stub.n_pipeline_create == pipelines + 1,
+          "changing only the back compare mask selects a new pipeline");
+    m(0x0348, 0);
+    draw_triangle();
+    CHECK(stub.back_stencil_ref == stub.stencil_ref,
+          "one-sided stencil applies the front reference to both faces");
+    engine_down();
+}
+
 static void test_restart_expansion(void)
 {
     printf("-- restart cuts\n");
@@ -2731,6 +2778,7 @@ int main(void)
     test_texture_sparse_rehash();
     test_compressed_volume();
     test_pipeline_key();
+    test_two_sided_stencil();
     test_restart_expansion();
     test_indexed_runs();
     test_indexed_draws();
