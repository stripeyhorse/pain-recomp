diff --git a/runtime/spu/spu_dispatch_mt.c b/runtime/spu/spu_dispatch_mt.c
index d9f86bb..51d24eb 100644
--- a/runtime/spu/spu_dispatch_mt.c
+++ b/runtime/spu/spu_dispatch_mt.c
@@ -21,6 +21,17 @@ typedef void (*spu_dispatch_fn)(spu_context*);
 spu_dispatch_fn spu_lookup(uint32_t addr, int image_id);  /* spu_channels.c (exported) */
 void spu_indirect_branch(spu_context* ctx);               /* full resolver in the lib */
 
+/* musttail is a clang attribute; GCC errors on it. Same guard the lifter's
+ * generated spu_recomp.h uses (SPU_TAILCALL). On non-clang the plain
+ * call+return relies on the compiler's sibling-call optimization, which GCC
+ * applies to this exact shape (single call, immediate return, void, shared
+ * signature). */
+#if defined(__clang__)
+#  define SPU_MT_TAILCALL(call) __attribute__((musttail)) return call
+#else
+#  define SPU_MT_TAILCALL(call) do { call; return; } while (0)
+#endif
+
 void spu_indirect_branch_mt(spu_context* ctx)
 {
     uint32_t pc = ctx->pc & SPU_LS_MASK;
@@ -62,9 +73,9 @@ void spu_indirect_branch_mt(spu_context* ctx)
         if (!fn) fn = spu_lookup(pc, ctx->image_id);
         if (fn) {
             ctx->pc = pc;
-            __attribute__((musttail)) return fn(ctx);
+            SPU_MT_TAILCALL(fn(ctx));
         }
     }
     /* slow / special path: full resolver (diagnostics, intercepts, miss log) */
-    __attribute__((musttail)) return spu_indirect_branch(ctx);
+    SPU_MT_TAILCALL(spu_indirect_branch(ctx));
 }
diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index 464ff41..68d1cff 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -2130,10 +2130,17 @@ class PPULifter:
                     return f"/* bl -> non-code 0x{tgt:08X} */;"
                 func.calls.append(tgt)
                 self.call_targets.add(tgt)
-                # PPC `bl` sets LR = return address (next instr). Emit it so mflr
-                # reads the correct value AND stack-saved LRs are real return
-                # addresses -> reliable back-chain unwinding for diagnostics.
-                return f"ctx->lr = 0x{insn.addr + 4:08X}; {self.prefix}func_{tgt:08X}(ctx); DRAIN_TRAMPOLINE(ctx);"
+                # PPC64 glink/PLT semantics: on real hardware a cross-module call
+                # goes through a glink stub that saves the caller's TOC into the
+                # ABI-reserved slot at sp+0x28 before swapping r2. The caller
+                # restores it afterwards with `ld r2, 40(r1)`. Some toolchains
+                # (this title's) emit that restore after EVERY bl. The lifted
+                # direct call bypasses the glink stub, so without this spill the
+                # caller's reload reads stale stack garbage and r2 dies (seen as
+                # r2=0 null-page cascades deep in static-init). Emit the save
+                # the stub would have made; the slot is reserved for exactly this.
+                return (f"vm_write64(ctx->gpr[1] + 0x28, ctx->gpr[2]); "
+                        f"ctx->lr = 0x{insn.addr + 4:08X}; {self.prefix}func_{tgt:08X}(ctx); DRAIN_TRAMPOLINE(ctx);")
             except ValueError:
                 return f"/* bl {target} */;"
 
