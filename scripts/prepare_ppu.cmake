cmake_minimum_required(VERSION 3.20)

# sim_steps=1 (sim_steps.cpp): a copy of the BCES00548 frame driver func_000CA158
# in which each per-step call runs only the first time it is reached in a frame.
# The driver advances the simulation by two fixed 1/60 s steps per rendered
# frame. These callees are the per-step work, called twice on every path:
#   0021A390 game clock tick       000DD2C4, 000C88F8, 001E1948 per-step updates
#   000C841C physics step (Havok)  000C84FC physics follow-up
#   000C911C world and logic step  000C8F14 logic step on the paths without 000C911C
# Every other call, branch and store is the lifted code unchanged. The copy is
# rebuilt from the lift on every configure. sim_steps=2 runs the lifted driver
# itself, or with PAIN_SIM_STATS=1 a copy that makes the same calls and counts them.
function(pain_prepare_one_step_driver lifted output)
    set(head "void func_000CA158(ppu_context* ctx) {\n")
    string(FIND "${lifted}" "${head}" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "Could not locate the BCES00548 frame driver.")
    endif()
    string(SUBSTRING "${lifted}" ${start} -1 body)
    string(FIND "${body}" "\n}\n" end)
    math(EXPR end "${end} + 3")
    string(SUBSTRING "${body}" 0 ${end} body)
    string(REPLACE "${head}" "void PAIN_DRIVER_NAME(ppu_context* ctx) {\n    uint32_t pain_steps_run = 0;\n" body "${body}")
    set(bit 0)
    # Expected call sites per callee in the 01.00 lift. A different count means
    # a different driver, so stop rather than guess.
    foreach(entry 0021A390:6 000DD2C4:6 000C841C:2 000C84FC:3 000C911C:2 000C8F14:6 000C88F8:8 001E1948:2)
        string(REPLACE ":" ";" entry "${entry}")
        list(GET entry 0 callee)
        list(GET entry 1 expected)
        # The match has no semicolon, so each one is a single list element.
        string(REGEX MATCHALL "func_${callee}\\(ctx\\)" sites "${body}")
        list(LENGTH sites count)
        if(NOT count EQUAL expected)
            message(FATAL_ERROR "The BCES00548 frame driver calls func_${callee} ${count} times, expected ${expected}.")
        endif()
        string(REPLACE "; func_${callee}(ctx);" "; PAIN_STEP_CALL(${bit}, func_${callee});" body "${body}")
        string(FIND "${body}" "func_${callee}(ctx)" left)
        if(NOT left EQUAL -1)
            message(FATAL_ERROR "A func_${callee} call in the BCES00548 frame driver has an unexpected form.")
        endif()
        math(EXPR bit "${bit} + 1")
    endforeach()
    # The chunk's own preamble (includes, helpers and macros the lifted bodies use).
    string(FIND "${lifted}" "\nvoid func_" first)
    string(SUBSTRING "${lifted}" 0 ${first} preamble)
    string(FIND "${preamble}" "PPU_MM_SNAP" snap)
    if(first EQUAL -1 OR snap EQUAL -1)
        message(FATAL_ERROR "Could not locate the lifted chunk preamble for the BCES00548 frame driver.")
    endif()
    # Two copies of the same body. pain_frame_driver_one_step runs each per-step
    # callee once per frame; pain_frame_driver_counted (PAIN_SIM_STATS=1 with
    # sim_steps=2 only) makes every call the lifted driver makes and counts them.
    set(driver "// Generated by scripts/prepare_ppu.cmake from the lifted func_000CA158. Do not edit.
${preamble}
extern uint64_t pain_step_calls[8];
#define PAIN_DRIVER_NAME pain_frame_driver_one_step
#define PAIN_STEP_CALL(bit, fn) do { if (!(pain_steps_run & (1u << (bit)))) { pain_steps_run |= 1u << (bit); pain_step_calls[bit]++; fn(ctx); } } while (0)
${body}
#undef PAIN_DRIVER_NAME
#undef PAIN_STEP_CALL
#define PAIN_DRIVER_NAME pain_frame_driver_counted
#define PAIN_STEP_CALL(bit, fn) do { (void)pain_steps_run; pain_step_calls[bit]++; fn(ctx); } while (0)
${body}")
    file(CONFIGURE OUTPUT "${output}/sim_steps_driver.cpp" CONTENT "@driver@" @ONLY)
endfunction()

function(pain_prepare_ppu output)
    file(GLOB RECOMP_SOURCES "${RECOMP_DIR}/*.c" "${RECOMP_DIR}/*.cpp")
    # Rename definitions only. Both direct calls and the registered function table
    # still use the original guest names, so each call goes through the port hook.
    set(pain_missing_wrappers 00011810 000CA158 00132D24 001AEFB0 0024206C 0024487C)
    set(pain_missing_fallbacks 001461FC 0015C7F8)
    foreach(source IN LISTS RECOMP_SOURCES)
        file(STRINGS "${source}" definitions REGEX
            "^void func_(00011810|000CA158|00132D24|001AEFB0|0024206C|0024487C|001461FC|0015C7F8)\\(ppu_context\\* ctx\\) [{]$")
        if(NOT definitions)
            continue()
        endif()
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
        endif()
        file(READ "${source}" lifted)
        foreach(definition IN LISTS definitions)
            string(SUBSTRING "${definition}" 10 8 address)
            if(address IN_LIST pain_missing_fallbacks)
                list(REMOVE_ITEM pain_missing_fallbacks "${address}")
            elseif(address STREQUAL "001AEFB0")
                # This worker exits through sys_ppu_thread_exit. Hook its
                # synchronous AutoLoad call before the game publishes completion.
                set(load_call "ctx->lr = 0x001AF068; func_00962344(ctx);")
                string(FIND "${lifted}" "${load_call}" load_site)
                if(load_site EQUAL -1)
                    message(FATAL_ERROR "Could not locate the BCES00548 profile load call.")
                endif()
                string(REPLACE "${load_call}"
                    "ctx->lr = 0x001AF068; pain_auto_load_profile(ctx);" lifted "${lifted}")
                list(REMOVE_ITEM pain_missing_wrappers "${address}")
            else()
                list(REMOVE_ITEM pain_missing_wrappers "${address}")
                if(address STREQUAL "000CA158")
                    pain_prepare_one_step_driver("${lifted}" "${output}")
                endif()
                set(original "void original_func_${address}(ppu_context* ctx) {")
                if(address STREQUAL "00011810")
                    set(original "static ${original}")
                endif()
                string(REPLACE "${definition}" "${original}" lifted "${lifted}")
            endif()
        endforeach()
        # The guarded lift shares one flag for all sites. Keep the tutorial
        # fallbacks dormant when the live stat is present.
        string(REGEX REPLACE "if [(]g_pain_unlock_all[)]([^\n]*insn patch 0x001(4628C|5C9F4):)"
            "if (pain_unlock_fallback())\\1" lifted "${lifted}")
        get_filename_component(chunk "${source}" NAME)
        set(wrapped "${output}/wrapped_${chunk}")
        set(wrapped_text "#include \"ppu_recomp.h\"\nextern \"C\" bool pain_unlock_fallback();\nvoid pain_auto_load_profile(ppu_context*);\n${lifted}")
        file(CONFIGURE OUTPUT "${wrapped}" CONTENT "@wrapped_text@" @ONLY)
        file(SHA256 "${source}" source_hash)
        list(APPEND wrappers "${chunk} ${source_hash}")
        if(NOT pain_missing_wrappers AND NOT pain_missing_fallbacks)
            break()
        endif()
    endforeach()
    if(pain_missing_wrappers OR pain_missing_fallbacks)
        message(FATAL_ERROR "The BCES00548 EBOOT lift is missing: ${pain_missing_wrappers} ${pain_missing_fallbacks}")
    endif()
    string(REPLACE ";" "\n" manifest "${wrappers}")
    file(CONFIGURE OUTPUT "${output}/wrapped_sources.txt" CONTENT "@manifest@\n" @ONLY)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT RECOMP_DIR OR NOT PREPARED_PPU_DIR)
        message(FATAL_ERROR "Set RECOMP_DIR and PREPARED_PPU_DIR.")
    endif()
    pain_prepare_ppu("${PREPARED_PPU_DIR}")
endif()
